{
	"name": "vunr",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "nuxt prepare",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"test": "vitest",
		"test:run": "vitest run",
		"test:watch": "vitest --watch",
		"test:unit": "vitest --project unit",
		"test:nuxt": "vitest --project nuxt",
		"typecheck": "nuxt typecheck",
		"verify": "pnpm lint && pnpm typecheck && pnpm test:run",
		"verify:full": "pnpm verify && pnpm build"
	},
	"dependencies": {
		"@nuxt/content": "3.14.0",
		"@nuxt/eslint": "1.15.2",
		"@nuxt/scripts": "1.2.1",
		"@nuxt/test-utils": "4.0.3",
		"@nuxt/ui": "4.8.2",
		"@nuxtjs/mdc": "^0.22.0",
		"@pinia/nuxt": "^0.11.3",
		"@unhead/vue": "2.1.15",
		"@vueuse/nuxt": "^14.3.0",
		"better-sqlite3": "12.10.0",
		"eslint": "10.4.1",
		"nuxt": "4.4.6",
		"pinia": "^3.0.4",
		"tailwindcss": "4.3.0",
		"typescript": "5.9.3",
		"vue": "3.5.35",
		"vue-router": "5.1.0"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.111",
		"@vue/test-utils": "2.4.11",
		"happy-dom": "20.10.1",
		"vitest": "4.1.8",
		"vue-tsc": "^3.3.3"
	}
}
